# Dependencies
node_modules/

# Build output
dist/
build/
.vite/

# Local database data directories (Postgres dev cluster / MariaDB test datadir).
# Never commit these — they are machine-local state, tens of MB of binary.
.pgdata-dev/
.pgdata/

# Environment
.env
.env.local
.env.*.local

# Logs & temp
*.log
*.tmp
npm-debug.log*

# Seed tooling runtime state (which demo accounts have been created).
# The scripts themselves ARE tracked; this file is regenerated on every run.
scripts/seed-created.json

# One-off diagnostic/verification scripts written during an audit session.
# Named tmp-* so they can never be committed by an over-eager `git add -A`.
scripts/tmp-*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
